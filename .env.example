# Export these values in Java/your terminal, or set them in Vercel.
# A .env file is not automatically loaded by this Java project.
APP_ENV=production
MYSQLHOST=your-mysql-host.example
MYSQLPORT=3306
MYSQLDATABASE=your_database
MYSQLUSER=your_database_user
MYSQLPASSWORD=
MYSQL_SSL_MODE=VERIFY_IDENTITY

# Alternative: the TiDB Marketplace variables are accepted automatically.
# Use MYSQL* OR TIDB_*, not both (MYSQL* takes precedence).
# TIDB_HOST=
# TIDB_PORT=4000
# TIDB_DATABASE=test
# TIDB_USER=
# TIDB_PASSWORD=
# Local HTTP only: APP_ENV=development and MYSQL_SSL_MODE=DISABLED.
