<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_1.xsd" version="6.1">
    <!-- Order matters: authorization precedes CSRF, so anonymous private calls get 401. -->
    <filter>
        <filter-name>security</filter-name>
        <filter-class>com.example.proyectojavalenguajemarcas.controller.FiltroSeguridad</filter-class>
    </filter>
    <filter-mapping><filter-name>security</filter-name><url-pattern>/*</url-pattern></filter-mapping>
    <filter>
        <filter-name>sharedRateLimit</filter-name>
        <filter-class>com.example.proyectojavalenguajemarcas.security.SharedRateLimit</filter-class>
    </filter>
    <filter-mapping><filter-name>sharedRateLimit</filter-name><url-pattern>/api/login</url-pattern><url-pattern>/api/registro</url-pattern><url-pattern>/api/sesion</url-pattern></filter-mapping>
    <filter>
        <filter-name>csrf</filter-name>
        <filter-class>org.apache.catalina.filters.RestCsrfPreventionFilter</filter-class>
    </filter>
    <filter-mapping><filter-name>csrf</filter-name><url-pattern>/api/*</url-pattern></filter-mapping>
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config><http-only>true</http-only></cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>
    <welcome-file-list><welcome-file>index.html</welcome-file></welcome-file-list>
</web-app>
